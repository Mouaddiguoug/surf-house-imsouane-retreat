# Base URL of the retreat API. Nothing is served from it yet — the site reads
# its content from `src/lib/data` — but `src/lib/api` is wired against this so
# the first endpoint only has to be injected, not plumbed.
NEXT_PUBLIC_API_URL=http://localhost:4000

# MapLibre style URL for the Imsouane map. Optional — the app falls back to
# OpenFreeMap's keyless Positron style when this is unset.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Cloudbeds Booking Engine property code: the six-character id at the end of
# the booking engine URL (Cloudbeds → Booking Engine → Summary). Drives the
# "Book a stay" dialog, which embeds Immersive Experience 2.0. The site's
# domain (and localhost while developing) must also be added under
# Booking Engine → Embeds → Whitelisted domains or the widget's API calls fail.
NEXT_PUBLIC_CLOUDBEDS_PROPERTY_CODE=
